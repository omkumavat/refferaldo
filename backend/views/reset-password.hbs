<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Your Password - Referly</title>
</head>

<body style="margin:0; padding:0; background-color:#080808; font-family:Arial,Helvetica,sans-serif; color:#f5f5f5;">

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0"
        style="background-color:#080808; padding:40px 16px;">
        <tr>
            <td align="center">

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0"
                    style="max-width:560px; background-color:#111111; border:1px solid #262626; border-radius:16px; overflow:hidden;">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="padding:32px 24px 20px;">
                            <h1 style="margin:0; font-size:30px; font-weight:800; letter-spacing:-1px; color:#ffffff;">
                                referly<span style="color:#22c55e;">.</span>
                            </h1>
                            <p style="margin:8px 0 0; color:#a3a3a3; font-size:13px;">
                                Your career, connected.
                            </p>
                        </td>
                    </tr>

                    <!-- Divider -->
                    <tr>
                        <td style="padding:0 28px;">
                            <div style="height:1px; background-color:#262626;"></div>
                        </td>
                    </tr>

                    <!-- Main content -->
                    <tr>
                        <td style="padding:32px 28px 16px;">

                            <h2 style="margin:0 0 16px; color:#ffffff; font-size:24px; line-height:1.4;">
                                Reset your password
                            </h2>

                            <p style="margin:0 0 16px; color:#d4d4d4; font-size:15px; line-height:1.8;">
                                Hi {{name}},
                            </p>

                            <p style="margin:0 0 24px; color:#a3a3a3; font-size:15px; line-height:1.8;">
                                We received a request to reset the password associated with your Referly account.
                                Click the button below to choose a new password.
                            </p>

                            <!-- CTA button -->
                            <table role="presentation" cellspacing="0" cellpadding="0" align="center"
                                style="margin:0 auto 28px;">
                                <tr>
                                    <td align="center" bgcolor="#22c55e" style="border-radius:8px;">
                                        <a href="{{resetUrl}}" target="_blank"
                                            style="display:inline-block; padding:15px 32px; color:#052e16; font-size:15px; font-weight:bold; text-decoration:none; border-radius:8px;">
                                            Reset Password
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <p style="margin:0 0 16px; color:#a3a3a3; font-size:13px; line-height:1.8;">
                                This link expires in <strong style="color:#ffffff;">15 minutes</strong>.
                                If you didn't request a password reset, you can safely ignore this email.
                                Your password will remain unchanged.
                            </p>

                            <p style="margin:0 0 8px; color:#737373; font-size:12px; line-height:1.8;">
                                If the button doesn't work, copy and paste this link into your browser:
                            </p>

                            <p
                                style="margin:0 0 24px; overflow-wrap:anywhere; word-break:break-word; font-size:12px; line-height:1.8;">
                                <a href="{{resetUrl}}" style="color:#4ade80; text-decoration:underline;">
                                    {{resetUrl}}
                                </a>
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="padding:20px 28px; border-top:1px solid #262626; text-align:center;">

                            <p style="margin:0 0 8px; color:#737373; font-size:12px; line-height:1.7;">
                                This is an automated security email from Referly.
                            </p>

                            <p style="margin:0; color:#525252; font-size:12px;">
                                &copy; 2026 Referly. All rights reserved.
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>